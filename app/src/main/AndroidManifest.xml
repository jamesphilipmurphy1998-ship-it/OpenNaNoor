<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Control Center's brightness slider - a "modify system settings"
         special permission, granted through its own dedicated system
         screen (ACTION_MANAGE_WRITE_SETTINGS) rather than a runtime
         dialog, but it still has to be declared here to be requestable
         at all. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Control Center's direct airplane-mode toggle. A signature/system
         permission - Android will never grant this through a normal
         install or runtime dialog, only via "adb shell pm grant" run once
         by hand. Declaring it here is what makes that grant possible at
         all; without it, adb's own grant command fails outright. Until
         granted, the airplane button falls back to opening Settings. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Control Center reads (never writes) current Wi-Fi/Bluetooth state
         to darken those tiles when already on - ACCESS_WIFI_STATE is
         a normal, install-time-granted permission; reading Bluetooth's
         adapter state needs BLUETOOTH_CONNECT as a runtime permission on
         API 31+, and the older BLUETOOTH permission (capped at API 30,
         where it was itself install-time) on anything before that. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenNaNoor">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OpenNaNoor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="true"
            android:label="OpenNaNoor Home"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.OpenNaNoor.Launcher"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TintOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a user-enabled screen tint overlay for as long as the user leaves it switched on." />
        </service>

        <service
            android:name=".service.AppMonitorService"
            android:exported="false"
            android:label="OpenNaNoor app monitor"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Control Center's now-playing row - see MediaListenerService's
             own doc comment for why this exists despite never reading
             actual notification content. permission="BIND_NOTIFICATION_
             LISTENER_SERVICE" restricts binding to the system itself, the
             same as any other listener service; enabling it for this app
             at all is a separate step in its own Settings screen. -->
        <service
            android:name=".service.MediaListenerService"
            android:exported="true"
            android:label="OpenNaNoor now playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".widget.ClockWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenNaNoor">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.ClockWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

    </application>

</manifest>