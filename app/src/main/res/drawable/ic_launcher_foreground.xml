<?xml version="1.0" encoding="utf-8"?>
<!--
  Four rounded tiles with one lifted out of the grid: the app rearranges and
  restyles what is on your home screen. Content stays inside the central 72dp
  safe zone so no part of it is lost to whatever mask the system applies.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top-left, top-right and bottom-left tiles: the settled grid. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M36,36m-6,0a6,6 0,0 1,6 -6h9a6,6 0,0 1,6 6v9a6,6 0,0 1,-6 6h-9a6,6 0,0 1,-6 -6z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M57,36m-6,0a6,6 0,0 1,6 -6h9a6,6 0,0 1,6 6v9a6,6 0,0 1,-6 6h-9a6,6 0,0 1,-6 -6z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M36,57m-6,0a6,6 0,0 1,6 -6h9a6,6 0,0 1,6 6v9a6,6 0,0 1,-6 6h-9a6,6 0,0 1,-6 -6z" />

    <!-- The fourth tile, lifted and fully opaque. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M60,54m-7,0a7,7 0,0 1,7 -7h12a7,7 0,0 1,7 7v12a7,7 0,0 1,-7 7h-12a7,7 0,0 1,-7 -7z" />
