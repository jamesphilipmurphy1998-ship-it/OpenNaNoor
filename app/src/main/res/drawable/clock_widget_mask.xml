<?xml version="1.0" encoding="utf-8"?>
<!-- Only used as the root's outline source for clipToOutline (see
     clock_widget.xml's own comment) - NOT decorative. Its fill must be
     fully transparent: android:background paints this drawable regardless
     of outlineProvider using it only for the outline's geometry, so a
     solid fill here would show through whenever clock_scrim itself goes
     transparent ("no background" mode) - alpha doesn't affect the
     outline's shape, only what's actually painted. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="16dp" />
    <solid android:color="#00000000" />
</shape>
