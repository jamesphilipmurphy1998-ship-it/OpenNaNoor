<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews only supports a small fixed set of layout/view classes, no
     Compose - a fixed stack of up to 4 rows, each hidden (GONE) when the
     widget has fewer cities configured than rows, is the simplest layout
     that still copes with a variable-length city list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC1C1C1E"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/clock_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/clock_label_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/clock_time_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/clock_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/clock_label_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/clock_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/clock_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/clock_label_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/clock_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/clock_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/clock_label_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/clock_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/clock_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap to add a city"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
